{
  "name": "lizliz-frontier",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4179 --strictPort",
    "build": "tsx scripts/content.ts && tsx scripts/prepare-build.ts && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && tsx scripts/prerender.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4179 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run content && npm run typecheck && npm run lint && npm run build && npm test && npm run audit:artifact",
    "content": "tsx scripts/content.ts",
    "agent": "tsx scripts/agent.ts",
    "audit:artifact": "tsx scripts/audit.ts",
    "report:bundle": "tsx scripts/bundle-report.ts",
    "verify": "npm run check"
  },
  "dependencies": {
    "@solidjs/web": "2.0.3",
    "@stylexjs/stylex": "0.19.2",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/solid": "0.1.0-beta.16",
    "solid-js": "2.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.1",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "gray-matter": "4.0.3",
    "image-size": "2.1.0",
    "jsdom": "31.0.1",
    "marked": "18.2.1",
    "sanitize-html": "2.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

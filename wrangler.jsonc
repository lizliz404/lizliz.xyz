{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lizliz-xyz",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./out"
  },
  "routes": [
    { "pattern": "lizliz.xyz/*", "zone_name": "lizliz.xyz" },
    { "pattern": "www.lizliz.xyz/*", "zone_name": "lizliz.xyz" }
  ],
  "observability": {
    "enabled": true
  }
}
